# Copy to .env and adjust. NEVER commit your real .env.

# --- mode -------------------------------------------------------------
# paper (default, no keys needed) | live (real money)
PM_MODE=paper
# Live trading refuses to start unless this is set EXACTLY as shown:
# PM_LIVE_ACK=I-UNDERSTAND-THE-RISKS

# --- credentials (live only) -------------------------------------------
# Export from Polymarket: Settings -> Export Private Key (email/Magic accounts).
# PM_PRIVATE_KEY=0x...
# Your Polymarket deposit/proxy wallet address (shown on your profile):
# PM_FUNDER=0x...
# 0 = plain EOA wallet, 1 = email/Magic account (most common), 2 = browser wallet
# PM_SIGNATURE_TYPE=1

# --- strategy ----------------------------------------------------------
# Which markets to trade (regex on the market question):
PM_MARKET_REGEX=(?i)^(bitcoin|btc)\b.*\bup or down\b
# Only markets resolving within this many hours:
PM_LOOKAHEAD_HOURS=2
# Required profit per share AFTER modeled fees (0.01 = 1 cent):
PM_MIN_EDGE=0.01
# Fee (bps) assumed when the API doesn't report one. Up/Down crypto
# markets have carried taker fees — verify before lowering this to 0.
PM_FEE_BPS_FALLBACK=0

# --- risk limits ---------------------------------------------------------
PM_MAX_USDC_PER_TRADE=25
PM_MAX_TOTAL_EXPOSURE=100
PM_COOLDOWN_S=5
# One-leg repair/unwind (live):
PM_REPAIR_ATTEMPTS=3
PM_MAX_UNWIND_LOSS=0.02

# --- pacing --------------------------------------------------------------
PM_SCAN_INTERVAL_S=1.0
PM_MARKET_REFRESH_S=60
